{
  "name": "shomer",
  "version": "0.1.0",
  "description": "Shomer - the runtime control plane for enterprise AI agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs",
    "test:tamper": "node scripts/tamper_test.mjs",
    "test:bypass": "node scripts/bypass_test.mjs",
    "test:mcp": "node scripts/mcp_test.mjs",
    "test:concurrency": "node scripts/concurrency_test.mjs",
    "test:truncation": "node scripts/tail_truncation_test.mjs",
    "test:approval": "node scripts/approval_identity_test.mjs",
    "test:ssrf": "node scripts/ssrf_rebind_test.mjs",
    "pilot": "node scripts/pilot_report.mjs",
    "sbom": "node scripts/sbom.mjs",
    "test:failclosed": "node scripts/ledger_failure_test.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:tamper && npm run test:mcp && npm run test:bypass && npm run test:concurrency && npm run test:truncation && npm run test:approval && npm run test:ssrf && npm run test:failclosed"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
